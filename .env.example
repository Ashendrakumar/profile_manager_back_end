# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────
PORT=10000
# Absolute URL this API is reachable at. Used to build download links for the
# LOCAL storage driver. In production set it to your deployed API origin.
BASE_URL=http://localhost:10000

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/profile_manager

# ─────────────────────────────────────────────────────────────────────────────
# Auth / crypto
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Frontend / portfolio
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
PORTFOLIO_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Email (Brevo / SMTP)
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SERVICE=
EMAIL_SECURE=
BREVO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:10000/api/users/auth/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# File storage
# ─────────────────────────────────────────────────────────────────────────────
# "local" (default) writes to src/uploads and serves via express.static.
# "r2" stores files in Cloudflare R2 (free tier: 10 GB, S3-compatible, no egress
# fees) so uploads survive redeploys on ephemeral hosts (Render, etc.).
STORAGE_DRIVER=local

# Cloudflare R2 — required only when STORAGE_DRIVER=r2.
# Create an R2 bucket, then an R2 API token (Account > R2 > Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: override the S3 endpoint. Defaults to
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public base URL for the bucket. Enable "Public Development URL" on the bucket
# (gives a https://pub-xxxxxxxx.r2.dev URL) or attach a custom domain. No
# trailing slash.
R2_PUBLIC_URL=
